<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Restricted Access</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <style>
    body {
      margin: 0;
      height: 100vh;
      background-color: #000;
      color: #fff;
      font-family: monospace;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .container {
      text-align: center;
      border: 1px solid #fff;
      padding: 40px;
      width: 320px;
    }

    h1 {
      margin-bottom: 20px;
      font-size: 20px;
      letter-spacing: 1px;
    }

    input {
      width: 100%;
      padding: 10px;
      background: #000;
      color: #fff;
      border: 1px solid #fff;
      font-family: monospace;
      margin-bottom: 15px;
    }

    button {
      width: 100%;
      padding: 10px;
      background: #000;
      color: #fff;
      border: 1px solid #fff;
      font-family: monospace;
      cursor: pointer;
    }

    button:hover {
      background: #fff;
      color: #000;
    }

    .message {
      margin-top: 15px;
      height: 16px;
    }
  </style>
</head>
<body>

  <div class="container">
    <h1>WELCOME, CASSIE</h1>

    <input
      type="password"
      id="password"
      placeholder="ENTER PASSWORD"
      autofocus
    >

    <button onclick="checkPassword()">ACCESS</button>

    <div class="message" id="message"></div>
  </div>

  <script>
    const CORRECT_PASSWORD = "94234932432731";

    function checkPassword() {
      const input = document.getElementById("password").value;
      const message = document.getElementById("message");

      if (input === CORRECT_PASSWORD) {
        message.textContent = "ACCESS GRANTED";
      } else {
        message.textContent = "ACCESS DENIED";
      }
    }
  </script>

</body>
</html>
